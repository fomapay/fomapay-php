{
    "name": "fomapay/fomapay-php",
    "description": "SDK PHP officiel de FomaPay : paiements FomaPay Direct et Mobile Money en RDC.",
    "type": "library",
    "license": "MIT",
    "keywords": ["fomapay", "paiement", "mobile money", "rdc", "m-pesa", "orange money", "airtel money"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "FomaPay\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "FomaPay\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
